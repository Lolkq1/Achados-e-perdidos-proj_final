<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Solicitação - IFAL</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/local.css">
    <script src="/authNeeded/solicitacao_editt.js" defer></script>
</head>
<body>
    <div class="d-flex">
        <nav class="sidebar-custom text-white p-3">
            <div class="sidebar-brand mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="ifal-dot"></span>
                    <span>Achados & Perdidos</span>
                </div>
                <span class="sidebar-badge">Campus IFAL</span>
            </div>
            <div class="nav flex-column">
                <a class="nav-link" href="/u/objetos"><i class="bi bi-box-seam"></i> Objetos</a>
                <a class="nav-link" href="/u/locais"><i class="bi bi-geo-alt"></i> Locais</a>
                <a class="nav-link active-link" href="/u/solicitacoes"><i class="bi bi-clipboard-check-fill"></i> Solicitações</a>
                <a class="nav-link" href="/u/etiquetas"><i class="bi bi-tags"></i> Etiquetas</a>
                <a class="nav-link" href="/u/categorias"><i class="bi bi-grid"></i> Categorias</a>
            </div>
        </nav>

        <div class="d-flex flex-column flex-grow-1">
            <nav class="navbar navbar-expand topbar-custom px-4">
                <div class="d-flex align-items-center gap-2 text-success fw-bold small">
                    <i class="bi bi-building-check fs-5"></i>
                    <span>Sistema Institucional de Achados e Perdidos</span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="user-pill d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill"></i>
                        <%= usuario %>
                    </span>
                    <a href="#" class="btn btn-outline-danger btn-sm btn-rounded" id="sair_btn">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            </nav>

            <div class="p-4">
                <div class="hero-banner mb-4 d-flex justify-content-between align-items-center">
                    <div style="position: relative; z-index: 1;">
                        <span class="hero-tag"><i class="bi bi-pencil-square"></i> Análise & Devolução</span>
                        <h3 class="fw-bold mb-1" id="main-title">Editar Solicitação de Devolução</h3>
                        <p class="mb-0 text-white-50 small">Atualize o status, a data de entrega, o responsável ou os detalhes da ocorrência.</p>
                    </div>
                    <div class="hero-illustration d-none d-md-flex align-items-center gap-3">
                        <i class="bi bi-clipboard2-check-fill fs-2 text-white"></i>
                    </div>
                </div>

                <div class="card card-modern p-4" style="max-width: 820px;">
                    <form action="/solicitacao" method="post" class="main2">
                        <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                            <i class="bi bi-geo-alt me-2"></i>Local e Turno da Ocorrência
                        </h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-success" for="turno">Turno</label>
                                <select class="form-select form-control-modern" name="turno" id="turno">
                                    <option value="matutino" <%= sol.sol_turno === 'Matutino' ? 'selected' : '' %>>Matutino</option>
                                    <option value="vespertino" <%= sol.sol_turno === 'Vespertino' ? 'selected' : '' %>>Vespertino</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-success" for="bloco">Bloco onde foi encontrado</label>
                                <select class="form-select form-control-modern" id="bloco" name="bloco">
                                    <option value="placeholder">Selecione o bloco.</option>
                                    <% for (let blo of blocos) { %>
                                        <option value="<%= blo.bloco %>" <%= sol.sol_bloco === blo.bloco ? 'selected' : '' %>>
                                            <%= blo.bloco %>
                                        </option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-success" for="local">Local / Sala</label>
                                <select class="form-select form-control-modern" id="local" name="local">
                                    <option value="placeholder">Selecione o local...</option>
                                    <% for (let x of locaisInit) { %>
                                        <option value="<%= x.id %>" <%= Number(sol.sol_local) === Number(x.id) ? 'selected' : '' %>>
                                            <%= x.nome %>
                                        </option>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                            <i class="bi bi-calendar-check me-2"></i>Datas, Status e Responsável
                        </h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="data_perdido">Data que foi perdido</label>
                                <input type="date" id="data_perdido" name="date" class="form-control form-control-modern" value="<%= sol.sol_data_perdido || '' %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="data_entrega">Data de Entrega</label>
                                <input type="date" id="data_entrega" name="data_entrega" class="form-control form-control-modern" value="<%= sol.sol_data_entrega || '' %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="status">Status</label>
                                <select class="form-select form-control-modern" id="status" name="status">
                                    <option value="Sob análise" <%= sol.sol_status === 'Sob análise' ? 'selected' : '' %>>Sob análise</option>
                                    <option value="Aprovada" <%= sol.sol_status === 'Aprovada' ? 'selected' : '' %>>Aprovada</option>
                                    <option value="Rejeitada" <%= sol.sol_status === 'Rejeitada' ? 'selected' : '' %>>Rejeitada</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="entregador">E-mail do entregador</label>
                                <input type="email" id="entregador" class="form-control form-control-modern" placeholder="entregador@ifal.edu.br" value="<%= sol.sol_responsavel_entrega %>">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-success" for="descricao">
                                <i class="bi bi-card-text me-1"></i> Descrição do Objeto
                            </label>
                            <textarea id="descricao" name="descricao" class="form-control form-control-modern" rows="5"><%= (typeof sol !== 'undefined' && (sol.sol_descricao_solicitante || sol.sol_descricao)) || '' %></textarea>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-ifal d-flex align-items-center gap-2" id="btn">
                                <i class="bi bi-check-circle-fill"></i> Salvar Alterações
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-rounded" id="btn_voltar" onclick="document.location.href='/u/solicitacoes'">
                                <i class="bi bi-arrow-left me-1"></i> Voltar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        const btn = document.querySelector("#sair_btn")
        btn.addEventListener('click', async (e) => {
            e.preventDefault()
            let a = await fetch('/api/user/logout')
            let c = await a.json()
            alert(c.msg)
            if (a.ok) {
                document.location.href = '/i/login'
            }
        })
    </script>
</body>
</html>