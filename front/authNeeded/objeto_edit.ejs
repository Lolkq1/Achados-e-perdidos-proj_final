<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel = "stylesheet" href = "/style.css">
    <title>Edição de objeto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="/authNeeded/objeto_editt.js" defer></script>
</head>
<body>
    <div class="d-flex">
        <div>
         <nav class="bg-dark text-white p-3 min-vh-100" style="width: 250px;">
            <h4 class="mb-4">Achados e Perdidos</h4>
            <div class="nav flex-column">
                <a class="nav-link text-white bg-success rounded" href="/u/objetos">Objetos</a>
                <a class="nav-link text-white" href="/u/locais">Locais</a>
                <a class="nav-link text-white" href="/u/solicitacoes">Solicitações</a>
                <a class="nav-link text-white" href="/u/etiquetas">Etiquetas</a>
                <a class="nav-link text-white" href="/u/categorias">Categorias</a>
                <a class="nav-link text-white" href="/u/usuarios">Usuarios</a>
            </div>
        </nav>
    </div>
    <div class="d-flex flex-column">
        <div>
        <div>
            <nav class="navbar navbar-expand-lg navbar-light bg-light min-vw-100" style="height: 50px;">
            <div class="collapse navbar-collapse" style="position: relative; left: 70%;">
                <div class="navbar-nav">
                    <a href="" class="nav-item nav-link disabled"><%=usuario %>></a>
                    <a href="" class="nav-item nav-link" id="sair_btn">Sair</a>
                </div>
            </div>
        </nav>
        </div>
        <div>
            <div id = "divPai" style="display: relative; left: 50%; transform: translate(-50%, 10%);";>
        <h1>Editar objeto</h1>
        <form>
           <h3>Informações do Objeto</h3>
            <div class="form-group my-2">
                <label for = "categoria">Categoria</label>
                <select class="form-select" id ="categoria" name ="categoria">
                    <% for (let categ of categorias) { %>
                        <option value="<%=categ.id%>" <%= obj.resto.obj_categoria == categ.id ? 'selected' : '' %>><%=categ.nome%></option>
                    <% } %>
                </select>
            </div>
            <div class="form-group my-2">
                 <h3>Local e Data</h3>
            <div class = "row">
                <div class = "column">
                    <label for ="data">Data do Ocorrido</label>
                    <input type="date" value="<%=obj.resto.obj_data%>" id ="data" name ="data">
                    <label for="turno" class="my-2">Turno</label>
                    <select class="form-select" value="<%=obj.resto.turno%>" name="turno" id="turno">
                        <option value="matutino" <%=obj.resto.turno === 'Matutino' ? 'selected' : ''%>>Matutino</option>
                        <option value="vespertino" <%=obj.resto.turno === 'Vespertino' ? 'selected' : ''%>>Vespertino</option>
                    </select>
            </div>
                <div class = "linha">
                    <label for ="bloco">Bloco onde foi encontrado</label>
                    <select class="form-select" id="bloco" name="bloco">
                        <option value="placeholder">Selecione o bloco.</option>
                        <% for (let blo of blocos) { %>
                            <option value="<%= blo.bloco %>" <%= obj.resto.obj_bloco === blo.bloco ? 'selected' : '' %>>
                                <%= blo.bloco %>
                            </option>
                        <% } %>
                    </select>
                </div>
                <div class = "linha">
                    <label for ="local">Local</label>
                    <select class="form-select" id="local" name="local">
                        <option value="placeholder">Selecione o local...</option>
                        <% for (let x of locaisInit) { %>
                            <option value="<%= x.id %>" <%= Number(obj.resto.obj_local) === Number(x.id) ? 'selected' : '' %>>
                                <%= x.nome %>
                            </option>
                        <% } %>
                    </select>
                </div>
            </div>
            </div>
            <h3>Etiquetas</h3>
            <div class = "divEtqMae">
            <div class = "Etq">
                <label for ="cor">Cor</label>
                <select name="etiquetacor" id="EtqCor" class="form-select">
                    <% for (let x of etiquetas.cor) { %>
                        <option value="<%=x.id%>" <%=obj.cor === x.id ? 'selected' : ''%>><%=x.cor %></option>
                    <% } %>
                </select>
            </div>
            <div class = "Etq">
                 <label for ="marca">Marca</label>
                <select name="etiquetamar" id="EtqMarca" class="form-select">
                    <% for (let x of etiquetas.marca) { %>
                        <option value="<%=x.id %>" <%=obj.mar === x.id ? 'selected' : ''%>><%=x.marca %></option>
                    <% } %>
                </select>
            </div>
            <div class = "Etq">
                 <label for ="material">Material</label>
                <select name="etiquetamat" id="EtqMaterial" class="form-select">
                    <% for (let x of etiquetas.material) { %>
                        <option value="<%=x.id %>" <%=obj.mat === x.id ? 'selected' : ''%>><%=x.material %></option>
                    <% } %>
                </select>
            </div>
            </div>
            <div>
                <label for="situacao">Situação</label>
                <select name="situacao" id="situacao" class="form-select">
                    <option value="Perdido" <%= obj.resto.situacao === 'Pendente' ? 'selected' : '' %>>Perdido</option>
                    <option value="Achado" <%= obj.resto.situacao === 'Achado' ? 'selected' : '' %>>Achado</option>
                </select>
</div>
            <div class = "descricao">
                <label for ="descricao" style="display: block;">Descrição Detalhada</label>
                <textarea id ="descricao" style="border: 1px solid black; border-radius: 5px;" name="descricao" rows="4" cols="30" disabled><%=obj.resto.obj_descricao%></textarea>
            </div>
            <button type ="submit" class = "btn btn-success" id="btn">Editar</button>
            <button class="btn btn-primary mx-2" id="btn_voltar">Voltar</button>
        </form>
    </div>
        </div>
    </div>
    </div>
    </div>
    <script>          
            const btn = document.querySelector("#sair_btn")
            btn.addEventListener('click', async (e) => {
                e.preventDefault()
                let a = await fetch('/api/user/logout')
                let b = await a.text()
                let c = await JSON.parse(b)
                alert(c.msg)
                if (a.ok) {
                    document.location.href='/i/login'
                }
            })
            
        </script>
</body>
</html>