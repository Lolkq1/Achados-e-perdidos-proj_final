<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas Solicitações - IFAL</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/local.css">
</head>
<body>
    <div class="d-flex">
        <nav class="sidebar-custom text-white p-3">
            <div class="sidebar-brand mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="ifal-dot"></span>
                    <span>Achados & Perdidos</span>
                </div>
                <span class="sidebar-badge">Campus IFAL</span>
            </div>
            <div class="nav flex-column">
                <a class="nav-link" href="/u/objetos"><i class="bi bi-box-seam"></i> Objetos</a>
                <a class="nav-link" href="/u/locais"><i class="bi bi-geo-alt"></i> Locais</a>
                <a class="nav-link active-link" href="/u/solicitacoes"><i class="bi bi-clipboard-check-fill"></i> Solicitações</a>
                <a class="nav-link" href="/u/etiquetas"><i class="bi bi-tags"></i> Etiquetas</a>
                <a class="nav-link" href="/u/categorias"><i class="bi bi-grid"></i> Categorias</a>
            </div>
        </nav>

        <div class="d-flex flex-column flex-grow-1">
            <nav class="navbar navbar-expand topbar-custom px-4">
                <div class="d-flex align-items-center gap-2 text-success fw-bold small">
                    <i class="bi bi-building-check fs-5"></i>
                    <span>Sistema Institucional de Achados e Perdidos</span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="user-pill d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill"></i>
                        <%= usuario %>
                    </span>
                    <a href="#" class="btn btn-outline-danger btn-sm btn-rounded" id="sair_btn">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            </nav>

            <div class="p-4">
                <div class="hero-banner mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div style="position: relative; z-index: 1;">
                        <span class="hero-tag"><i class="bi bi-clipboard-check-fill"></i> Devoluções & Pedidos</span>
                        <h3 class="fw-bold mb-1">Minhas Solicitações</h3>
                        <p class="mb-0 text-white-50 small">Acompanhe o andamento das suas solicitações de devolução de objetos perdidos.</p>
                    </div>
                    <div class="d-flex align-items-center gap-3" style="position: relative; z-index: 1;">
                        <div class="hero-illustration d-none d-md-flex align-items-center gap-3">
                            <i class="bi bi-clipboard2-check-fill fs-3 text-warning"></i>
                            <i class="bi bi-envelope-paper-fill fs-3 text-white"></i>
                        </div>
                        <button type="button" class="btn btn-ifal-light d-flex align-items-center gap-2" onclick="document.location.href='/u/solicitacao'">
                            <i class="bi bi-plus-circle-fill"></i> Nova solicitação
                        </button>
                    </div>
                </div>

                <div class="card card-modern p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-success mb-0"><i class="bi bi-list-check me-2"></i>Histórico de Solicitações</h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-list-ul me-1"></i> <%= sols.length %> registro(s) nesta tela
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">ID</th>
                                    <th>Situação</th>
                                    <th>Data (Perdido)</th>
                                    <th>Data (Entrega)</th>
                                    <th>E-mail do Entregador</th>
                                    <th>Descrição</th>
                                    <th class="text-end" style="width: 130px;">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (sols.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-5">
                                            <i class="bi bi-clipboard-x fs-1 text-success opacity-50 d-block mb-2"></i>
                                            <span class="fw-semibold d-block">Nenhuma solicitação encontrada</span>
                                            <small>Clique em "Nova solicitação" para registrar um pedido de devolução.</small>
                                        </td>
                                    </tr>
                                <% } %>
                                <% if (sols.length > 0) { %>
                                    <% sols.forEach(sol => { %>
                                        <tr>
                                            <td><span class="id-pill">#<%= sol.id %></span></td>
                                            <td>
                                                <span class="badge-bloco">
                                                    <i class="bi bi-hourglass-split"></i>
                                                    <%= sol.status %>
                                                </span>
                                            </td>
                                            <td class="fw-medium text-dark"><%= sol.data_perdido.toLocaleString('PT-BR').split(',')[0] %></td>
                                            <td class="text-muted"><%= sol.data_entrega ? new Date(sol.data_entrega).toLocaleDateString('pt-BR') : 'Indefinido' %></td>
                                            <td class="fw-medium text-dark"><%= sol.email_entregador %></td>
                                            <td>
                                                <button type="button" class="btn btn-outline-primary btn-sm btn-rounded" data-bs-toggle="modal" data-bs-target="#modal<%= sol.id %>">
                                                    <i class="bi bi-eye"></i> Expandir
                                                </button>
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-outline-danger btn-sm btn-rounded" onclick="removerSolicitacao('<%= sol.id %>')">
                                                    <i class="bi bi-trash3"></i> Remover
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (sols.length > 0) { %>
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <span class="text-muted small">Exibindo página <strong class="text-success"><%= pag %></strong></span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-success btn-sm btn-rounded" <%= pag <= 1 ? 'disabled' : '' %> onclick="document.location.href='/u/solicitacoes/<%= sols[0].id_usuario %>?pag=<%= pag - 1 %>'">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm btn-rounded" <%= sols.length < 7 ? 'disabled' : '' %> onclick="document.location.href='/u/solicitacoes/<%= sols[0].id_usuario %>?pag=<%= pag + 1 %>'">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <% if (sols.length > 0) { %>
        <% sols.forEach((sol) => { %>
            <div class="modal fade" id="modal<%= sol.id %>" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; border-top: 4px solid #007a3d !important;">
                        <div class="modal-header border-bottom">
                            <h5 class="modal-title fw-bold text-success">
                                <i class="bi bi-card-text me-2"></i>Descrição da Solicitação #<%= sol.id %>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="mb-0 text-dark"><%= sol.descricao_solicitante %></p>
                        </div>
                        <div class="modal-footer border-top-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm btn-rounded" data-bs-dismiss="modal">Fechar</button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function removerSolicitacao(id) {
            if (!confirm('Tem certeza que deseja remover esta solicitação?')) return
            let res = await fetch('/api/solicitacao/' + id, { method: 'DELETE' })
            let dados = await res.json()
            alert(dados.msg)
            if (res.ok) {
                window.location.reload()
            }
        }

        const btn = document.querySelector("#sair_btn")
        btn.addEventListener('click', async (e) => {
            e.preventDefault()
            let a = await fetch('/api/user/logout')
            let c = await a.json()
            alert(c.msg)
            if (a.ok) {
                document.location.href = '/i/login'
            }
        })
    </script>
</body>
</html>