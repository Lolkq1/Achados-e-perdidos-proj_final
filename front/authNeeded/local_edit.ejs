<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel = "stylesheet" href = "/style2.css">
    <title>Edição de objeto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="/authNeeded/local_editt.js" defer></script>
</head>
<body>
    <div class="d-flex">
        <div>
         <nav class="bg-dark text-white p-3 min-vh-100" style="width: 250px;">
            <h4 class="mb-4">Achados e Perdidos</h4>
            <div class="nav flex-column">
                <a class="nav-link text-white" href="/u/objetos">Objetos</a>
                <a class="nav-link text-white bg-success rounded" href="/u/locais">Locais</a>
                <a class="nav-link text-white" href="/u/solicitacoes">Solicitações</a>
                <a class="nav-link text-white" href="/u/etiquetas">Etiquetas</a>
                <a class="nav-link text-white" href="/u/categorias">Categorias</a>
            </div>
        </nav>
    </div>
    <div class="d-flex flex-column">
        <div>
        <div>
            <nav class="navbar navbar-expand-lg navbar-light bg-light min-vw-100" style="height: 50px;">
            <div class="collapse navbar-collapse" style="position: relative; left: 70%;">
                <div class="navbar-nav">
                    <a href="" class="nav-item nav-link disabled"><%=usuario %>></a>
                    <a href="" class="nav-item nav-link" id="sair_btn">Sair</a>
                </div>
            </div>
        </nav>
        </div>
        <div>
            <form class="main2" action="">
                <h1 class="m-3" id="main-title">Editar Local</h1>
            <div class="form-group mx-3 my-3">
                <label class="my-2" for="bloco" style="display: block;">Bloco</label>
                <input type="text" id="bloco" class="form-control" value="<%=loc.bloco%>">
                <label class="my-2" for="local" style="display: block;">Local</label>
                <input type="text" id="local" class="form-control"C value="<%=loc.nome%>">
            </div>
            <div class="form-group mx-3 my-3">
                <button class="btn btn-success my-3" id="btn">Salvar</button>
                <button class="btn btn-primary my-3" id="btn_voltar" onclick="document.location.href='/u/locais'">
                    Voltar
                </button> 
            </div>
            </form>
        
        </div>
    </div>
    </div>
    </div>
    <script>          
            const btn = document.querySelector("#sair_btn")
            btn.addEventListener('click', async (e) => {
                e.preventDefault()
                let a = await fetch('/api/user/logout')
                let b = await a.text()
                let c = await JSON.parse(b)
                alert(c.msg)
                if (a.ok) {
                    document.location.href='/i/login'
                }
            })
            
        </script>
</body>
</html>