<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Locais Registrados - IFAL</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/local.css">
</head>
<body>
    <div class="d-flex">
        <nav class="sidebar-custom text-white p-3">
            <div class="sidebar-brand mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="ifal-dot"></span>
                    <span>Achados & Perdidos</span>
                </div>
                <span class="sidebar-badge">Campus IFAL</span>
            </div>
            <div class="nav flex-column">
                <a class="nav-link" href="/u/objetos"><i class="bi bi-box-seam"></i> Objetos</a>
                <a class="nav-link active-link" href="/u/locais"><i class="bi bi-geo-alt-fill"></i> Locais</a>
                <a class="nav-link" href="/u/solicitacoes"><i class="bi bi-clipboard-check"></i> Solicitações</a>
                <a class="nav-link" href="/u/etiquetas"><i class="bi bi-tags"></i> Etiquetas</a>
                <a class="nav-link" href="/u/categorias"><i class="bi bi-grid"></i> Categorias</a>
            </div>
        </nav>

        <div class="d-flex flex-column flex-grow-1">
            <nav class="navbar navbar-expand topbar-custom px-4">
                <div class="d-flex align-items-center gap-2 text-success fw-bold small">
                    <i class="bi bi-building-check fs-5"></i>
                    <span>Sistema Institucional de Achados e Perdidos</span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="user-pill d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle"></i>
                        <%= usuario %>
                    </span>
                    <a href="#" class="btn btn-outline-danger btn-sm btn-rounded" id="sair_btn">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            </nav>

            <div class="p-4">
                <div class="hero-banner mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div style="position: relative; z-index: 1;">
                        <span class="hero-tag"><i class="bi bi-geo-alt-fill"></i> Guia do Campus</span>
                        <h3 class="fw-bold mb-1">Locais do IFAL</h3>
                        <p class="mb-0 text-white-50 small">Consulte os blocos e salas cadastrados para localizar onde seu item foi encontrado.</p>
                    </div>
                    <div class="hero-illustration d-none d-md-flex align-items-center gap-3">
                        <i class="bi bi-key-fill fs-3 text-warning"></i>
                        <i class="bi bi-backpack-fill fs-3 text-white"></i>
                        <i class="bi bi-search fs-3 text-info"></i>
                    </div>
                </div>

                <div class="card card-modern p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                        <form class="d-flex flex-wrap gap-2 flex-grow-1" method="GET" action="/u/locais">
                            <div class="input-group search-box-ifal" style="max-width: 440px;">
                                <span class="input-group-text bg-white border-0 text-success"><i class="bi bi-search"></i></span>
                                <input type="text" name="q" class="form-control border-0 shadow-none" placeholder="Pesquisar por bloco ou sala..." value="<%= busca %>">
                            </div>
                            <button type="submit" class="btn btn-ifal">Pesquisar</button>
                            <% if (busca) { %>
                                <a href="/u/locais?pag=1" class="btn btn-outline-secondary btn-rounded d-flex align-items-center">Limpar</a>
                            <% } %>
                        </form>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-list-ul me-1"></i> <%= locs.length %> registro(s) nesta tela
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 90px;">ID</th>
                                    <th style="width: 240px;">Bloco</th>
                                    <th>Local / Sala</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locs.length === 0) { %>
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-5">
                                            <i class="bi bi-geo-alt fs-1 text-success opacity-50 d-block mb-2"></i>
                                            <span class="fw-semibold d-block">Nenhum local encontrado</span>
                                            <small>Tente pesquisar usando outro bloco ou sala.</small>
                                        </td>
                                    </tr>
                                <% } %>
                                <% locs.forEach(loc => { %>
                                    <tr>
                                        <td><span class="id-pill">#<%= loc.id %></span></td>
                                        <td>
                                            <span class="badge-bloco">
                                                <i class="bi bi-building"></i>
                                                <%= loc.bloco %>
                                            </span>
                                        </td>
                                        <td class="fw-semibold text-dark">
                                            <i class="bi bi-door-open text-success me-2"></i><%= loc.nome %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% if (!busca) { %>
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <span class="text-muted small">Exibindo página <strong class="text-success"><%= pag %></strong></span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-success btn-sm btn-rounded" <%= pag <= 1 ? 'disabled' : '' %> onclick="document.location.href='/u/locais?pag=<%= pag - 1 %>'">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm btn-rounded" <%= locs.length < 7 ? 'disabled' : '' %> onclick="document.location.href='/u/locais?pag=<%= pag + 1 %>'">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const btn = document.querySelector("#sair_btn")
        btn.addEventListener('click', async (e) => {
            e.preventDefault()
            let a = await fetch('/api/user/logout')
            let c = await a.json()
            alert(c.msg)
            if (a.ok) {
                document.location.href = '/i/login'
            }
        })
    </script>
</body>
</html>