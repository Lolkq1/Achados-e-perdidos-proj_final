<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAR NÃO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style2.css">
</head>
<body>
    <div class="d-flex">
        <div>
            <nav class="bg-dark text-white p-3 min-vh-100" style="width: 250px;">
            <h4 class="mb-4">Achados e Perdidos</h4>
            <div class="nav flex-column">
                <a class="nav-link text-white" href="/u/objetos">Objetos</a>
                <a class="nav-link text-white" href="/u/locais">Locais</a>
                <a class="nav-link text-white" href="/u/solicitacoes">Solicitações</a>
                <a class="nav-link text-white bg-success rounded" href="/u/etiquetas">Etiquetas</a>
                <a class="nav-link text-white" href="/u/categorias">Categorias</a>
            </div>
        </nav>
        </div>
        <div class="d-flex flex-column">
            <div>
                <nav class="navbar navbar-expand-lg navbar-light bg-light min-vw-100" style="height: 50px;">
                <div class="collapse navbar-collapse" style="position: relative; left: 70%;">
                    <div class="navbar-nav">
                        <a href="" class="nav-item nav-link disabled"><%= usuario%></a>
                        <a href="" class="nav-item nav-link" id="sair_btn">Sair</a>
                    </div>
                </div>
                </nav>
            </div>
            <div>
            <div class="flex-grow-1 p-4">
            <h2>Etiquetas</h2>
            <button type="button" class="btn btn-success mb-3" onclick="document.location.href='/u/categoria'">+ Nova etiqueta</button>
            <table class="table w-75" style="border-right: solid 2px black;">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Cor</th>
                        <th>Marca</th>
                        <th>Material</th>
                    </tr>
                </thead>
                <tbody>
                   <% etqs.forEach(etq => { %>
                    <tr> 
                        <td><%=etq.id %></td>
                        <td><%=etq.cor%></td>
                        <td><%=etq.marca%></td>
                        <td><%=etq.material%></td>
                   </tr>
                   <% }) %>
                </tbody>
            </table>
            <button class="btn btn-secondary" style="position: absolute; top: 67%; left: 14.2%;" onclick="document.location.href='/u/etiquetas?pag=<%=pag-1 %>'"><</button>
            <button class="btn btn-secondary" style="position: absolute; top: 67%; left: 17%;" onclick="document.location.href='/u/etiquetas?pag=<%=pag+1 %>'">></button>
        </div>
            
        </div>
    </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>          
            const btn = document.querySelector("#sair_btn")
            btn.addEventListener('click', async (e) => {
                e.preventDefault()
                let a = await fetch('/api/user/logout')
                let b = await a.text()
                let c = await JSON.parse(b)
                alert(c.msg)
                if (a.ok) {
                    document.location.href='/i/login'
                }
            })
            
        </script>
</body>
</html>