<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAR NÃO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style2.css">
</head>
<body>
    <div class="d-flex">
        <div>
            <nav class="bg-dark text-white p-3 min-vh-100" style="width: 250px;">
                <h4 class="mb-4">Achados e Perdidos</h4>
                <div class="nav flex-column">
                    <a class="nav-link text-white bg-success rounded" href="/u/objetos">Objetos</a>
                    <a class="nav-link text-white" href="/u/locais">Locais</a>
                    <a class="nav-link text-white" href="/u/solicitacoes">Solicitações</a>
                    <a class="nav-link text-white" href="/u/etiquetas">Etiquetas</a>
                    <a class="nav-link text-white" href="/u/categorias">Categorias</a>
                </div>
            </nav>
        </div>

        <div class="d-flex flex-column flex-grow-1">
            <div>
                <nav class="navbar navbar-expand-lg navbar-light bg-light min-vw-100" style="height: 50px;">
                    <div class="collapse navbar-collapse" style="position: relative; left: 70%;">
                        <div class="navbar-nav">
                            <a href="" class="nav-item nav-link disabled"><%= usuario%></a>
                            <a href="" class="nav-item nav-link" id="sair_btn">Sair</a>
                        </div>
                    </div>
                </nav>
            </div>

            <div class="flex-grow-1 p-4 position-relative">
                <h2>Objetos perdidos</h2>
                <button type="button" class="btn btn-success mb-3" onclick="document.location.href='/u/objeto'">+ Novo objeto</button>
                <button type="button" class="btn btn-secondary mb-3" style="display: block;" data-bs-toggle="modal" data-bs-target="#modalFiltro">Filtros</button>
                
                <table class="table w-75" style="border-right: solid 2px black;">
                    <thead class="table-dark">
                        <tr>
                            <th>Data</th>
                            <th>Turno</th>
                            <th>Local</th>
                            <th>Categoria</th>
                        </tr>
                    </thead>
                    <tbody>
                    <% if (objs.length > 0) { %> 
                       <% objs.forEach(obj => { %>
                        <tr>
                            <td><%=obj.data.toLocaleString('PT-BR').split(',')[0]%> </td>
                            <td><%=obj.turno %></td>
                            <td><%=obj.localformat %></td>
                            <td><%=obj.categoria_nome %></td>
                       </tr>
                       <% }) %>
                    <% } %>
                    </tbody>
                </table>

                <% if (objs.length > 0) { %>
                <button class="btn btn-secondary" style="position: absolute; top: 67%; left: 14.2%;" onclick="document.location.href='/u/objetos?pag=<%=pag-1 %>'"><</button>
                <button class="btn btn-secondary" style="position: absolute; top: 67%; left: 17%;" onclick="document.location.href='/u/objetos?pag=<%=pag+1 %>'">></button>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Modal corrigido -->
    <div class="modal fade" id="modalFiltro" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Filtrar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-label" for="bloco">Bloco</label>
                            <select name="" id="bloco" class="form-select" style="display: block;">
                                <option value="placeholder">Selecione um bloco</option>
                                <% for (let blo of blocos) { %>
                                    <option value="<%=blo.bloco%>"><%=blo.bloco%></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Local</label>
                            <select name="" id="local" class="form-select" disabled>

                            </select>
                        </div>
                        <div class="mb-3 d-flex d-column space-evenly" style="width: 100%;">
                            <div>
                                <label for="data_inicio" style="display: block;">Data inicial</label>
                                <input type="date" id="data_inicio">
                            </div>
                            <div style="width: 33%;"></div>
                            <div>
                                <label for="data_final" style="display: block;">Data final</label>
                                <input type="date" id="data_final">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="categoria" style="display: block;">Categoria</label>
                            <select name="" id="categoria" class="form-select">
                                <option value="placeholder">Selecione uma categoria</option>
                                <% for (let cat of categorias) { %>
                                <option value="<%=cat.nome%>"><%=cat.nome%></option>
                                <% } %>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success">Filtrar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>          
        const btn = document.querySelector("#sair_btn")
        btn.addEventListener('click', async (e) => {
            e.preventDefault()
            let a = await fetch('/api/user/logout')
            let b = await a.text()
            let c = await JSON.parse(b)
            alert(c.msg)
            if (a.ok) {
                document.location.href='/i/login'
            }
        })

        const bloco = document.querySelector("#bloco")
        bloco.addEventListener('change', async (e) => {
            let local = document.querySelector("#local")
            console.log(bloco.value)
            if (bloco.value === 'placeholder' || bloco.value==="nulo") {
                local.innerHTML = ''
                local.disabled = true
                return;
            }
            let a = await fetch(`/api/local/${bloco.value}`)
            let b = await a.text()
            let c = await JSON.parse(b)
            local.innerHTML = ''
            local.disabled = false
            for (let x of c.locais) {
                let opt = document.createElement('option')
                console.log('a ser inserido, id:'+x.id, ', nome:'+x.nome)
                opt.value=`${x.id}`
                opt.textContent=x.nome
                local.appendChild(opt)
            }
        })
    </script>
</body>
</html>