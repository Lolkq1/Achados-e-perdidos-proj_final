<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Objetos Perdidos - IFAL</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/local.css">
</head>
<body>
    <div class="d-flex">
        <nav class="sidebar-custom text-white p-3">
            <div class="sidebar-brand mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="ifal-dot"></span>
                    <span>Achados & Perdidos</span>
                </div>
                <span class="sidebar-badge">Campus IFAL</span>
            </div>
            <div class="nav flex-column">
                <a class="nav-link active-link" href="/u/objetos"><i class="bi bi-box-seam-fill"></i> Objetos</a>
                <a class="nav-link" href="/u/locais"><i class="bi bi-geo-alt"></i> Locais</a>
                <a class="nav-link" href="/u/solicitacoes"><i class="bi bi-clipboard-check"></i> Solicitações</a>
                <a class="nav-link" href="/u/etiquetas"><i class="bi bi-tags"></i> Etiquetas</a>
                <a class="nav-link" href="/u/categorias"><i class="bi bi-grid"></i> Categorias</a>
            </div>
        </nav>

        <div class="d-flex flex-column flex-grow-1">
            <nav class="navbar navbar-expand topbar-custom px-4">
                <div class="d-flex align-items-center gap-2 text-success fw-bold small">
                    <i class="bi bi-building-check fs-5"></i>
                    <span>Sistema Institucional de Achados e Perdidos</span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="user-pill d-flex align-items-center gap-2">
                        <i class="bi bi-person-circle"></i>
                        <%= usuario %>
                    </span>
                    <a href="#" class="btn btn-outline-danger btn-sm btn-rounded" id="sair_btn">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            </nav>

            <div class="p-4">
                <div class="hero-banner mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div style="position: relative; z-index: 1;">
                        <span class="hero-tag"><i class="bi bi-box-seam-fill"></i> Inventário do Campus</span>
                        <h3 class="fw-bold mb-1">Objetos Perdidos</h3>
                        <p class="mb-0 text-white-50 small">Consulte os itens registrados no campus ou cadastre um novo objeto encontrado.</p>
                    </div>
                    <div class="d-flex align-items-center gap-3" style="position: relative; z-index: 1;">
                        <div class="hero-illustration d-none d-md-flex align-items-center gap-3">
                            <i class="bi bi-key-fill fs-3 text-warning"></i>
                            <i class="bi bi-backpack-fill fs-3 text-white"></i>
                            <i class="bi bi-phone-fill fs-3 text-info"></i>
                        </div>
                        <button type="button" class="btn btn-ifal-light d-flex align-items-center gap-2" onclick="document.location.href='/u/objeto'">
                            <i class="bi bi-plus-circle-fill"></i> Novo objeto
                        </button>
                    </div>
                </div>

                <div class="card card-modern p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-success mb-0"><i class="bi bi-box-seam me-2"></i>Itens Registrados</h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-list-ul me-1"></i> <%= objs.length %> registro(s) nesta tela
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern mb-0">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Turno</th>
                                    <th>Local</th>
                                    <th>Categoria</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (objs.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-5">
                                            <i class="bi bi-box-seam fs-1 text-success opacity-50 d-block mb-2"></i>
                                            <span class="fw-semibold d-block">Nenhum objeto registrado no momento</span>
                                            <small>Clique em "Novo objeto" para cadastrar um item encontrado.</small>
                                        </td>
                                    </tr>
                                <% } %>
                                <% if (objs.length > 0) { %>
                                    <% objs.forEach(obj => { %>
                                        <tr>
                                            <td class="fw-medium text-dark"><%= obj.data.toLocaleString('PT-BR').split(',')[0] %></td>
                                            <td class="text-capitalize text-muted"><%= obj.turno %></td>
                                            <td>
                                                <span class="badge-bloco">
                                                    <i class="bi bi-geo-alt"></i>
                                                    <%= obj.localformat %>
                                                </span>
                                            </td>
                                            <td class="fw-semibold text-dark"><%= obj.categoria_nome %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (objs.length > 0) { %>
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <span class="text-muted small">Exibindo página <strong class="text-success"><%= pag %></strong></span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-success btn-sm btn-rounded" <%= pag <= 1 ? 'disabled' : '' %> onclick="document.location.href='/u/objetos?pag=<%= pag - 1 %>'">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm btn-rounded" <%= objs.length < 7 ? 'disabled' : '' %> onclick="document.location.href='/u/objetos?pag=<%= pag + 1 %>'">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const btn = document.querySelector("#sair_btn")
        btn.addEventListener('click', async (e) => {
            e.preventDefault()
            let a = await fetch('/api/user/logout')
            let c = await a.json()
            alert(c.msg)
            if (a.ok) {
                document.location.href = '/i/login'
            }
        })
    </script>
</body>
</html>