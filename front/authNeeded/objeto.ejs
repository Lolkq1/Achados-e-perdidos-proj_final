<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Objeto - IFAL</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/local.css">
    <script src="/authNeeded/objeto.js" defer></script>
</head>
<body>
    <div class="d-flex">
        <nav class="sidebar-custom text-white p-3">
            <div class="sidebar-brand mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="ifal-dot"></span>
                    <span>Achados & Perdidos</span>
                </div>
                <span class="sidebar-badge">Campus IFAL</span>
            </div>
            <div class="nav flex-column">
                <a class="nav-link active-link" href="/u/objetos"><i class="bi bi-box-seam-fill"></i> Objetos</a>
                <a class="nav-link" href="/u/locais"><i class="bi bi-geo-alt"></i> Locais</a>
                <a class="nav-link" href="/u/solicitacoes"><i class="bi bi-clipboard-check"></i> Solicitações</a>
                <a class="nav-link" href="/u/etiquetas"><i class="bi bi-tags"></i> Etiquetas</a>
                <a class="nav-link" href="/u/categorias"><i class="bi bi-grid"></i> Categorias</a>
            </div>
        </nav>

        <div class="d-flex flex-column flex-grow-1">
            <nav class="navbar navbar-expand topbar-custom px-4">
                <div class="d-flex align-items-center gap-2 text-success fw-bold small">
                    <i class="bi bi-building-check fs-5"></i>
                    <span>Sistema Institucional de Achados e Perdidos</span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="user-pill d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill"></i>
                        <%= usuario %>
                    </span>
                    <a href="#" class="btn btn-outline-danger btn-sm btn-rounded" id="sair_btn">
                        <i class="bi bi-box-arrow-right"></i> Sair
                    </a>
                </div>
            </nav>

            <div class="p-4">
                <div class="hero-banner mb-4 d-flex justify-content-between align-items-center">
                    <div style="position: relative; z-index: 1;">
                        <span class="hero-tag"><i class="bi bi-plus-circle"></i> Novo Registro</span>
                        <h3 class="fw-bold mb-1">Cadastrar Novo Objeto</h3>
                        <p class="mb-0 text-white-50 small">Preencha as características, o local e a data em que o item foi encontrado.</p>
                    </div>
                    <div class="hero-illustration d-none d-md-flex align-items-center gap-3">
                        <i class="bi bi-box-seam-fill fs-2 text-white"></i>
                    </div>
                </div>

                <div class="card card-modern p-4" style="max-width: 820px;">
                    <form>
                        <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                            <i class="bi bi-info-circle me-2"></i>Informações do Objeto
                        </h5>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-success" for="categoria">Categoria</label>
                            <select class="form-select form-control-modern" id="categoria" name="categoria">
                                <% for (let categ of categorias) { %>
                                    <option value="<%= categ.id %>"><%= categ.nome %></option>
                                <% } %>
                            </select>
                        </div>

                        <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                            <i class="bi bi-geo-alt me-2"></i>Local e Data
                        </h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="data">Data do Ocorrido</label>
                                <input type="date" id="data" name="data" class="form-control form-control-modern">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="turno">Turno</label>
                                <select class="form-select form-control-modern" name="turno" id="turno">
                                    <option value="matutino">Matutino</option>
                                    <option value="vespertino">Vespertino</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="bloco">Bloco onde foi encontrado</label>
                                <select class="form-select form-control-modern" id="bloco">
                                    <option value="placeholder">Selecione o bloco.</option>
                                    <% for (let blo of blocos) { %>
                                        <option value="<%= blo.bloco %>"><%= blo.bloco %></option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-success" for="local">Local / Sala</label>
                                <select class="form-select form-control-modern" id="local" disabled></select>
                            </div>
                        </div>

                        <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                            <i class="bi bi-tags me-2"></i>Etiquetas
                        </h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-success" for="EtqCor">Cor</label>
                                <select name="etiquetacor" id="EtqCor" class="form-select form-control-modern">
                                    <% for (let x of etiquetas.cor) { %>
                                        <option value="<%= x.id %>"><%= x.cor %></option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-success" for="EtqMarca">Marca</label>
                                <select name="etiquetamar" id="EtqMarca" class="form-select form-control-modern">
                                    <% for (let x of etiquetas.marca) { %>
                                        <option value="<%= x.id %>"><%= x.marca %></option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-success" for="EtqMaterial">Material</label>
                                <select name="etiquetamat" id="EtqMaterial" class="form-select form-control-modern">
                                    <% for (let x of etiquetas.material) { %>
                                        <option value="<%= x.id %>"><%= x.material %></option>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-success" for="descricao">
                                <i class="bi bi-card-text me-1"></i> Descrição Detalhada
                            </label>
                            <textarea id="descricao" class="form-control form-control-modern" name="descricao" rows="4" placeholder="Descreva detalhes que ajudem a identificar o objeto..."></textarea>
                        </div>

                        <div class="d-flex gap-2 pt-2">
                            <button type="submit" class="btn btn-ifal d-flex align-items-center gap-2" id="btn">
                                <i class="bi bi-check-circle-fill"></i> Cadastrar Objeto
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-rounded" id="btn_voltar" onclick="document.location.href='/u/objetos'">
                                <i class="bi bi-arrow-left me-1"></i> Voltar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        const btn = document.querySelector("#sair_btn")
        btn.addEventListener('click', async (e) => {
            e.preventDefault()
            let a = await fetch('/api/user/logout')
            let c = await a.json()
            alert(c.msg)
            if (a.ok) {
                document.location.href = '/i/login'
            }
        })
    </script>
</body>
</html>